# Odin Connect configuration (all optional — sensible defaults applied).
# Copy to `.env` and adjust for your environment.

# App name shown in the Odin approval popup.
VITE_ODIN_APP_NAME="Odin App Template"

# Odin environment: prod | dev | local
VITE_ODIN_ENV=prod

# App canister principal — transfer destination + actor target for deposit/
# withdraw. dfx writes canister ids to the root `.env` on deploy; copy the
# `canister` id here.
VITE_APP_CANISTER_ID=

# dfx network: local (default) uses a local replica + fetches the root key;
# ic targets mainnet.
VITE_DFX_NETWORK=local

# Replica/boundary host (optional). Defaults: local → http://127.0.0.1:4943,
# ic → https://icp-api.io
# VITE_IC_HOST=http://127.0.0.1:4943
